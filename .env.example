VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# Opcional, só para rodar `node scripts/db-migrate.mjs` localmente (aplica migrações
# direto no banco). NUNCA prefixar com VITE_ — não pode ir para o bundle do navegador.
# Pegue em Project Settings > Database > Connection string (URI).
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
